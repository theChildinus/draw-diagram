{
  "name": "neutral-engineering-default",
  "provenance": {
    "source": "Agents365-ai/drawio-skill",
    "license": "MIT"
  },
  "application": {
    "new_diagrams": "default",
    "existing_diagrams": "preserve unless the user explicitly asks to restyle or redraw"
  },
  "canvas": {
    "background": "#FFFFFF"
  },
  "palette": {
    "neutral": {
      "fillColor": "#FFFFFF",
      "strokeColor": "#626B73",
      "use": "ordinary modules, services, controllers, storage, messaging, and observability nodes; do not assign a different color to each role"
    },
    "context": {
      "fillColor": "#F8F9FA",
      "strokeColor": "#626B73",
      "use": "optional light neutral fill for external context or flow terminals"
    },
    "focus": {
      "fillColor": "#EFF3F6",
      "strokeColor": "#45637A",
      "fontColor": "#2D4E67",
      "strokeWidth": 1.5,
      "use": "one muted accent for the current diagram's core object or step; do not also use it as a category color"
    },
    "risk": {
      "fillColor": "#FFFFFF",
      "strokeColor": "#DC2626",
      "use": "errors or risks that need explicit visual emphasis; use a labeled border or badge, and keep ordinary failure branches neutral"
    }
  },
  "status_badges": {
    "healthy": {
      "fillColor": "#DCFCE7",
      "strokeColor": "#15803D",
      "label": "正常"
    },
    "warning": {
      "fillColor": "#FEF3C7",
      "strokeColor": "#D97706",
      "label": "警告"
    },
    "error": {
      "fillColor": "#FEE2E2",
      "strokeColor": "#DC2626",
      "label": "故障"
    },
    "planned": {
      "fillColor": "#F8F9FA",
      "strokeColor": "#67727D",
      "label": "待建设",
      "style": "dashed=1"
    },
    "deprecated": {
      "fillColor": "#F8F9FA",
      "strokeColor": "#DC2626",
      "label": "已废弃",
      "style": "dashed=1"
    }
  },
  "vertices": {
    "common_style": "whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#626B73;strokeWidth=1.25;shadow=0;glass=0;sketch=0",
    "service_shape": "rounded=0",
    "control_shape": "rounded=0",
    "storage_shape": "shape=cylinder3",
    "decision_shape": "rhombus",
    "external_shape": "rounded=0;dashed=1",
    "terminator_shape": "rounded=1;arcSize=50",
    "container_shape": "rounded=0;container=1;fillColor=#FFFFFF;strokeColor=#8A949D;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8",
    "swimlane_shape": "swimlane;startSize=30",
    "corner_radius": {
      "compact_card_arc_size": 4,
      "large_background_container_arc_size": 4,
      "large_background_container_max_arc_size": 4,
      "large_background_container_min_width": 300,
      "large_background_container_min_height": 300
    },
    "baseline_node_size": {
      "width": 160,
      "height": 48
    }
  },
  "font": {
    "latin_font_family": "Helvetica",
    "chinese_font_family": "PingFang SC",
    "ordinary_size": 16,
    "secondary_size": 13,
    "diagram_title_size": 24,
    "region_title_size": 16,
    "focus_size": 16,
    "focus_bold": true,
    "color": "#252B31"
  },
  "edges": {
    "style": "edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#67727D;strokeWidth=1.25;endArrow=classic;endSize=7;endFill=1",
    "label_size": 13,
    "label_color": "#4B5560",
    "relationship_styles": {
      "synchronous": "strokeColor=#67727D;strokeWidth=1.25;dashed=0",
      "main_path": "strokeColor=#404A53;strokeWidth=1.5",
      "asynchronous": "strokeColor=#67727D;strokeWidth=1.25;dashed=1;dashPattern=6 4",
      "observability_or_state_feedback": "strokeColor=#67727D;strokeWidth=1.25;dashed=1;dashPattern=1 4",
      "supporting_dependency": "strokeColor=#67727D;strokeWidth=1.25",
      "error_failure_or_timeout": "strokeColor=#67727D;strokeWidth=1.25",
      "highlighted_error": "strokeColor=#DC2626;strokeWidth=1.25",
      "highlighted_observability": "strokeColor=#45637A;strokeWidth=1.5;dashed=1;dashPattern=1 4"
    }
  }
}
